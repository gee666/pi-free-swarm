{
  "name": "oira666_pi-free-swarm",
  "version": "0.4.0",
  "description": "Pi extension that launches a leaderless swarm of pi agents that self-organise on a shared wall, with a live web board.",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "index.ts",
    "src/",
    "ui_dist/",
    "README.md",
    "EVERGREEN.md",
    "docs/file-previews.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi",
    "swarm",
    "multi-agent",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-free-swarm.git"
  },
  "license": "MIT",
  "scripts": {
    "pretest": "npm install --save-dev --ignore-scripts @earendil-works/pi-agent-core@latest @earendil-works/pi-ai@latest @earendil-works/pi-coding-agent@latest @earendil-works/pi-tui@latest && npm run typecheck",
    "test": "node --import tsx/esm --test \"test/**/*.test.ts\"",
    "test:e2e": "node --import tsx/esm --test \"test/e2e/*.e2e.ts\"",
    "test:evergreen": "npm test -- --test-concurrency=1 && npm run test:ui && npm run test:e2e",
    "pretest:ui": "npm run pretest",
    "test:ui": "vitest run --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run test:ui && npm run format:check && npm run check:size && npm run check:package"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.4.0",
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@fontsource/inter": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.540.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tsx": "^4.23.13",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
